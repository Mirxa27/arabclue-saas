# ─── Public site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://arabclue.com
# Salla App Store install URL (marketing CTAs) — falls back to /signup if unset
NEXT_PUBLIC_SALLA_INSTALL_URL=

# Optional distributed rate limiting (falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Reverse proxies in front of the app that append to X-Forwarded-For. The client IP used for
# rate limiting is the entry this many hops from the right. Hostinger/Passenger = 1 (default),
# Cloudflare → Hostinger = 2, no proxy = 0. Ignored on Vercel (platform header is used).
TRUSTED_PROXY_HOPS=1

# Optional error tracking (structured JSON logs always; Sentry when set)
SENTRY_DSN=

# Optional — disable server-side analytics event logging
ANALYTICS_DISABLED=

# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Max ms the boot-time secret hydration waits on Supabase before falling back to
# process.env (keeps server startup from hanging if the DB is unreachable). Default 3000.
PLATFORM_SECRETS_TIMEOUT_MS=

# ─── AI providers ───────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# For PDPL-residency in-Kingdom inference (optional, when wired):
HUMAIN_API_BASE=
HUMAIN_API_KEY=

# ─── Salla App ──────────────────────────────────────────────────────────────
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI=https://arabclue.com/api/salla/oauth/callback
SALLA_WEBHOOK_SECRET=

# ─── ZATCA / Fatoora (set after CSID onboarding) ────────────────────────────
ZATCA_FATOORA_BASE=https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal
ZATCA_CSID=
ZATCA_PRIVATE_KEY_PEM=

# ─── Wathq (B2B intelligence) ───────────────────────────────────────────────
WATHQ_API_KEY=

# ─── Social platform connectors ─────────────────────────────────────────────
# Meta (Instagram + WhatsApp Business) — OAuth redirect
# Social publishing always uses each merchant's own connected accounts; there are
# no platform-wide posting tokens (they would publish merchants' posts on the
# operator's accounts).
META_APP_ID=
# Also the HMAC key for X-Hub-Signature-256 on /api/meta/webhook (deliveries refused while unset)
META_APP_SECRET=
META_REDIRECT_URI=https://arabclue.com/api/oauth/meta/callback
META_WEBHOOK_VERIFY_TOKEN=
# Graph API version for every Graph / Facebook Login call (default v26.0 in lib/meta/graph.ts)
META_GRAPH_VERSION=
# Per-employee WhatsApp webhook verification (fallback when integration has no verify_token)
WHATSAPP_VERIFY_TOKEN=

# Slack Events API signing secret of the platform Slack app (fallback when an employee's
# integration has no signing_secret). With neither, Slack events are refused (503).
SLACK_SIGNING_SECRET=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://arabclue.com/api/oauth/linkedin/callback

# X (Twitter) OAuth 2.0
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://arabclue.com/api/oauth/x/callback

# TikTok OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://arabclue.com/api/oauth/tiktok/callback

# OAuth state signing + social inbound bridge bearer token (a blank SOCIAL_INBOUND_SECRET
# falls back to CRON_SECRET; with neither, /api/social/inbound answers 503)
OAUTH_STATE_SECRET=
SOCIAL_INBOUND_SECRET=

# Platform admin (comma-separated emails allowed to access /admin)
PLATFORM_ADMIN_EMAILS=

# Encrypt OAuth tokens at rest (32+ char random string — required in production)
TOKEN_ENCRYPTION_KEY=

# Voice telephony bridge — bearer token for /api/voice/webhook (503 while unset)
VOICE_BRIDGE_SECRET=
VOICE_BRIDGE_WS_URL=
TWILIO_ACCOUNT_SID=
# Also verifies X-Twilio-Signature on /api/voice/twilio/inbound (calls refused while unset)
TWILIO_AUTH_TOKEN=
# ISO country for number search (SA for production; US for sandbox testing)
TWILIO_NUMBER_COUNTRY=SA

# ─── Payments (Moyasar) ─────────────────────────────────────────────────────
MOYASAR_PUBLIC_KEY=
NEXT_PUBLIC_MOYASAR_PUBLIC_KEY=
MOYASAR_SECRET_KEY=
# Required: must equal the "secret token" set on the Moyasar webhook (sent as secret_token
# in every delivery). While unset /api/billing/webhook refuses all deliveries (503).
MOYASAR_WEBHOOK_SECRET=

# ─── Cron auth ──────────────────────────────────────────────────────────────
CRON_SECRET=change-me-to-a-strong-random-string

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Optional; also settable in /admin/config. Without RESEND_API_KEY support
# tickets are still stored, but no acknowledgement or relay email is sent.
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_FROM_EMAIL=
SUPPORT_REPLY_TO=
# New support tickets are forwarded here when set.
SUPPORT_INBOX_EMAIL=
