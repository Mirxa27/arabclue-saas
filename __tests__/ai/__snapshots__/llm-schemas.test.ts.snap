exports[`LLM structured-output schemas (wire format) > PlannedPostSchema matches its pinned JSON Schema 1`] = `
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "goal": {
      "enum": [
        "awareness",
        "consideration",
        "conversion",
        "engagement",
        "retention",
      ],
      "type": "string",
    },
    "hook": {
      "description": "One-line hook in the chosen dialect",
      "type": "string",
    },
    "platforms": {
      "items": {
        "enum": [
          "instagram",
          "tiktok",
          "x",
          "snapchat",
          "linkedin",
          "whatsapp",
        ],
        "type": "string",
      },
      "maxItems": 6,
      "minItems": 1,
      "type": "array",
    },
    "productIds": {
      "description": "Salla product IDs referenced — empty for brand posts",
      "items": {
        "type": "string",
      },
      "type": "array",
    },
    "rationale": {
      "description": "Why this post on this day — 1 sentence",
      "type": "string",
    },
    "scheduledFor": {
      "description": "ISO 8601 timestamp with the +03:00 offset, inside the allowed window",
      "type": "string",
    },
  },
  "required": [
    "scheduledFor",
    "platforms",
    "goal",
    "productIds",
    "hook",
    "rationale",
  ],
  "type": "object",
}
`;

