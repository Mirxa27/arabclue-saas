exports[`LLM structured-output schemas (wire format) > ToolDecisionSchema matches its pinned JSON Schema 1`] = `
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "body": {
      "maxLength": 4000,
      "type": "string",
    },
    "calendar_attendees": {
      "items": {
        "format": "email",
        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
        "type": "string",
      },
      "maxItems": 20,
      "type": "array",
    },
    "calendar_end": {
      "type": "string",
    },
    "calendar_start": {
      "type": "string",
    },
    "calendar_summary": {
      "maxLength": 200,
      "type": "string",
    },
    "channel": {
      "enum": [
        "whatsapp",
        "telegram",
        "slack",
        "email",
        "gmail",
        "twilio_sms",
        "webhook",
        "meta",
        "instagram",
      ],
      "type": "string",
    },
    "followup_in_minutes": {
      "maximum": 43200,
      "minimum": 5,
      "type": "integer",
    },
    "human_reason": {
      "maxLength": 400,
      "type": "string",
    },
    "invoice_buyer_phone": {
      "maxLength": 32,
      "type": "string",
    },
    "invoice_total": {
      "exclusiveMinimum": 0,
      "type": "number",
    },
    "reasoning": {
      "default": "",
      "maxLength": 400,
      "type": "string",
    },
    "salla_order_id": {
      "maxLength": 64,
      "type": "string",
    },
    "subject": {
      "maxLength": 200,
      "type": "string",
    },
    "task_description": {
      "maxLength": 1000,
      "type": "string",
    },
    "task_due_in_hours": {
      "maximum": 720,
      "minimum": 1,
      "type": "integer",
    },
    "task_priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "urgent",
      ],
      "type": "string",
    },
    "task_title": {
      "maxLength": 200,
      "type": "string",
    },
    "to": {
      "maxLength": 200,
      "type": "string",
    },
    "tool": {
      "default": "none",
      "enum": [
        "none",
        "create_task",
        "send_message",
        "schedule_followup",
        "create_calendar_event",
        "lookup_salla_order",
        "create_invoice",
        "escalate_to_human",
      ],
      "type": "string",
    },
    "use_tool": {
      "type": "boolean",
    },
  },
  "required": [
    "use_tool",
  ],
  "type": "object",
}
`;

